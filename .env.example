# Required production configuration for the delivery origin.
# Set both values to the store origin. Do not invent coordinates.
# Do not copy a customer's current location into these values.
# Leave both empty until the business supplies the origin.
DELIVERY_ORIGIN_LATITUDE=
DELIVERY_ORIGIN_LONGITUDE=

# Authentication provider.
# Leave this empty to use the development adapter. That adapter stores a hash in
# this browser only. It is not production authentication and it does not send email.
# Any other name keeps sign-in unavailable until a server adapter is connected.
# Do not put API keys, passwords, or other secrets in frontend environment variables.
AUTH_PROVIDER=

# Razorpay server keys. Leave both empty until the dashboard generates a pair.
# Test keys start with rzp_test_ and do not charge real money.
# The key secret stays on the server. Do not use a NEXT_PUBLIC_ variable for it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Invoice email. Leave SMTP_PASS empty until the mailbox has an app password.
# Checkout still accepts the order when this password is empty.
# Do not commit the password. Do not put it in a NEXT_PUBLIC_ variable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
